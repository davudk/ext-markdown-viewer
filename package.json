{
  "name": "ext-markdown-viewer",
  "description": "Renders .md files in the browser instead of showing raw text.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "audit:network": "node scripts/audit-network.mjs",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run compile && npm run test && npm run build && npm run check:build && npm run audit:network",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "docx": "9.7.1",
    "dompurify": "3.4.12",
    "highlight.js": "11.11.1",
    "katex": "0.17.0",
    "marked": "18.0.7",
    "marked-emoji": "2.0.3",
    "marked-footnote": "1.4.0",
    "marked-highlight": "2.2.4",
    "marked-katex-extension": "5.1.10",
    "mermaid": "11.16.0",
    "node-emoji": "2.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/chrome": "0.1.28",
    "@types/jsdom": "27.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.1.5",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "wxt": "0.20.27"
  }
}
