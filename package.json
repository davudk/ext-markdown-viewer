{
  "name": "ext-markdown-viewer",
  "description": "Renders .md files in the browser instead of showing raw text.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/fix-noncharacters.mjs",
    "build:firefox": "wxt build -b firefox && node scripts/fix-noncharacters.mjs",
    "zip": "npm run build && wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "audit:network": "node scripts/audit-network.mjs",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run compile && npm run test && npm run build && npm run check:build && npm run audit:network",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "diff": "9.0.0",
    "docx": "9.7.1",
    "dompurify": "3.4.12",
    "fuse.js": "7.5.0",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.1",
    "markdown-it-container": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-multimd-table": "4.2.3",
    "mermaid": "11.16.0",
    "panzoom": "9.4.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/chrome": "0.1.28",
    "@types/jsdom": "27.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.1.5",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "wxt": "0.20.27"
  }
}
